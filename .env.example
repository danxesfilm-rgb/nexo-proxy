# Ejemplo de configuración para el proxy de descargas de YouTube

# Endpoint RapidAPI yt-dlp
YTDLP_API_URL=https://yt-dlp-api.p.rapidapi.com/
YTDLP_API_METHOD=GET
YTDLP_API_HEADERS=x-rapidapi-host: yt-dlp-api.p.rapidapi.com; x-rapidapi-key: TU_RAPIDAPI_KEY

# Si tu servicio usa Authorization Bearer en vez de cabeceras RapidAPI explícitas:
# YTDLP_API_KEY=TU_TOKEN
# YTDLP_API_HEADER=Authorization
# YTDLP_API_KEY_PREFIX=Bearer

# También puedes usar un servicio YTDLP diferente
# YTDLP_API_URL=https://mi-servicio-ytdlp.example/api/convert
# YTDLP_API_METHOD=POST
# YTDLP_API_HEADERS=Content-Type: application/json
